/* tankcheck.js - the help page's tank check (2026-10-03).

   A keeper with a tank that won't come on plugs it into a computer, and this
   reads what the tank says about itself over USB: the firmware's own log and
   its console's answers to `state`, `battery`, `batlog` and `pmic`. All of it
   stays in the page; nothing is uploaded. The keeper can copy the report and
   post it where they ask for help.

   Two halves:
     diagnose(text, ctx)  - pure: a log in, findings out. The paste box and the
                            USB reader both end here, and so can a test.
     the USB reader       - Web Serial (Chrome / Edge on a computer). Opening
                            the port does not reset the board; "Restart and
                            check again" does, on purpose, to read a startup.

   The lines it looks for are the firmware's own (firmware/main/main.c,
   battery_port_axp2101.c, display_port_sh8601.c, director.c) plus the ESP32's
   boot ROM and panic handler. A wording change there wants a look here. */
(() => {
  'use strict';
  const strip = s => s.replace(/\x1b\[[0-9;]*m/g, '').replace(/IMPROV[^\n]{0,40}?(?=[IWE] \(\d+\))/g, '').replace(/[^\n\t\x20-\x7e]/g, '');   /* colors, the installer handshake's binary packets, stray bytes */
  const esc = s => String(s).replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
  const last = (text, re) => { let m, out = null; const g = new RegExp(re.source, 'g'); while ((m = g.exec(text))) out = m; return out; };
  const count = (text, re) => (text.match(new RegExp(re.source, 'g')) || []).length;

  /* the AXP2101's own account of the last power-off and power-on (REG 21 / 20,
     logged by the firmware as "PMIC at boot"), per its datasheet */
  const OFF_BITS = [[0x80, 'the board got too hot'], [0x40, 'a supply rail went too high'], [0x20, 'a supply rail dropped too low'],
                    [0x10, 'the USB voltage was too high'], [0x08, 'the power ran too low (an empty battery, or the power was cut)'],
                    [0x04, 'the PWR key was held down'], [0x02, 'the tank powered itself off (its normal sleep)'], [0x01, 'the PWR key was held for a forced off']];
  const ON_BITS = [[0x01, 'the PWR key'], [0x04, 'the USB cable'], [0x08, 'the battery, charged back up'], [0x10, 'a battery being connected'], [0x02, 'the IRQ pin'], [0x20, 'the EN pin']];
  const bits = (v, table) => table.filter(([b]) => v & b).map(([, s]) => s);

  function diagnose(raw, ctx = {}) {
    const text = strip(raw);
    const out = [], facts = [];
    const add = (level, title, body, steps) => out.push({ level, title, body, steps: steps || [] });

    /* ---- what is there ---- */
    const ver = last(text, /pocket-tank v(\S+) (\S+) \(build ([^)]+)\)(?: for (\S+))? boot/);
    const rsts = [...text.matchAll(/rst:0x([0-9a-f]+) \(([A-Z0-9_]+)\),boot:0x([0-9a-f]+) \(([^)]+)\)/g)];
    const status = last(text, /t=(\d+)s (\d+) fish goals: ([^|]*)\| asks (\d+) decisions (\d+)[^\n]*heap int (\d+) KB psram (\d+) KB \| battery (-?\d+)% (-?\d+) mV bright (\d+)/);
    const fps = last(text, /display: ([\d.]+) fps/);
    const fish = [...text.matchAll(/director: (\d) (\S+)\s+(fry|juv\w*|adult|elder)\s+age ([\d.]+)h/g)];
    const light = last(text, /\| (night|day)( \(manual\))? idle (\d+)s/);
    const panel = last(text, /panel up: ([^\n]*)/);
    const pmic = last(text, /PMIC at boot: power-on source ([0-9a-f]{2}), power-off source ([0-9a-f]{2})/);
    const gauge = last(text, /battery page: (-?\d+)% ([A-Z ()a-z]+?)(?: \(STAGED\))? \|/);
    const cold = last(text, /cold boot: [^\n]*?([\d.]+) h lived through/);
    const panics = [...text.matchAll(/Guru Meditation Error: Core\s+(\d) panic'ed \(([^)]+)\)/g)];
    const aborts = [...text.matchAll(/(abort\(\) was called at PC 0x[0-9a-f]+[^\n]*|assert failed: [^\n]*)/g)];
    const wdt = count(text, /task_wdt: Task watchdog got triggered/);
    const backtrace = last(text, /Backtrace: ?([^\n]*)/);
    const boots = Math.max(count(text, /ESP-ROM:/), count(text, /pocket-tank v\S+ \S+ \(build/));
    const crashes = panics.length + aborts.length + wdt;
    const running = !!(fps || status || fish.length);
    const sleepAt = text.lastIndexOf('sleep: save, panel off');
    const wokeAt = Math.max(text.lastIndexOf('wake within the grace'), text.lastIndexOf('ESP-ROM:'), ver ? ver.index : -1);
    const asleep = sleepAt >= 0 && sleepAt > wokeAt;
    const poweredOff = asleep && /grace over: PMIC power-off|power-off now: saving tank|deep sleep \(/.test(text.slice(sleepAt));

    if (ver) facts.push(['Version', `${ver[1]} ${ver[2]}, build ${ver[3]}${ver[4] ? `, for ${ver[4]}` : ''}`]);
    if (fish.length) {
      const seen = new Map(); for (const f of fish) seen.set(f[1], f);      /* the last answer per slot */
      facts.push(['Fish', [...seen.values()].map(f => `${f[2]} (${f[3]}, ${Math.round(+f[4])} h old)`).join(', ')]);
    } else if (status) facts.push(['Fish', `${status[2]}`]);
    if (status) {
      const up = last(text, /\((\d+)\) pocket-tank: t=\d+s/);    /* the log's own stamp: ms since this start (t= is the tank's clock, which a save carries) */
      const upS = up ? up[1] / 1000 : 0;
      if (up) facts.push(['Running since its last start', upS >= 3600 ? `${(upS / 3600).toFixed(1)} h` : upS >= 60 ? `${Math.round(upS / 60)} min` : 'under a minute']);
      facts.push(['Battery', +status[8] < 0 ? 'no gauge answering' : `${status[8]}%, ${status[9]} mV`]);
      facts.push(['Screen brightness', `${Math.round(status[10] / 2.55)}%`]);
      facts.push(['Free memory', `${status[6]} KB internal, ${status[7]} KB extra`]);
    }
    if (gauge) facts.push(['Power', gauge[2].trim().toLowerCase()]);
    if (fps) facts.push(['Drawing', `${fps[1]} frames a second`]);
    if (panel) facts.push(['Screen', panel[1]]);
    if (light) facts.push(['Tank light', light[1] === 'night' ? 'off' : 'on']);
    if (cold) facts.push(['Time away before this start', `${cold[1]} h`]);
    if (rsts.length) facts.push(['Last restart', rsts.map(r => r[2]).join(', ')]);
    if (pmic) {
      const on = parseInt(pmic[1], 16), off = parseInt(pmic[2], 16);
      facts.push(['Turned on by', `${bits(on, ON_BITS).join(' + ') || 'not recorded'} (${pmic[1]})`]);
      facts.push(['Last power-off', `${bits(off, OFF_BITS).join(' + ') || 'not recorded'} (${pmic[2]})`]);
    }

    /* ---- what it means, worst first ---- */
    const sendFirst = 'Copy the report below and send it to us before you change anything. It shows where the tank stops.';
    const reinstall = 'Reinstall from the <a href="/install/">install page</a> with the main button. It keeps your tank.';
    const erase = 'Last resort: the install page\'s <em>Erase the board and install fresh</em>. This wipes your tank, so send the report first.';

    const lastRst = rsts[rsts.length - 1];
    if (lastRst && /DOWNLOAD/.test(lastRst[4]) && (!ver || ver.index < lastRst.index)) {
      add('problem', 'The board is in install mode',
          'It started with <kbd>BOOT</kbd> held down, so it is waiting for an install and the screen stays black. Your tank is fine.',
          ['Unplug the cable.', 'Plug it back in without touching any key.', 'If the screen stays black, hold <kbd>PWR</kbd> for one second.']);
    } else if (count(text, /invalid header: 0x/) >= 3 || /No bootable app|Failed to verify partition table/.test(text)) {
      add('problem', 'There is no Pocket Tank on this board',
          'The board starts, but finds nothing to run. An install that stopped partway looks like this.',
          [`${reinstall} If you never had a tank on it, you get a new one.`]);
    } else if (/it has no picture here/.test(text)) {
      add('problem', 'This board has another board\'s Pocket Tank on it',
          'The tank is running, but it was built for a different screen, so this one stays black.',
          ['Go to the <a href="/install/">install page</a>, pick your board, and install. Your tank stays.']);
    } else if (/nothing answers on the I2C bus/.test(text)) {
      add('problem', 'The board\'s chips are not answering',
          'The tank starts but cannot reach the screen, the power chip or the touch chip. That is a hardware fault or a board Pocket Tank does not know.',
          ['Unplug everything, the battery too if you can, wait a minute, and try again.', sendFirst]);
    } else if (crashes >= 2 || (crashes && !running)) {
      const what = panics.length ? `"${panics[panics.length - 1][2]}"` : aborts.length ? `"${aborts[aborts.length - 1][1].slice(0, 80)}"` : 'a watchdog timeout';
      add('problem', 'The tank crashes when it starts',
          `It stopped with ${what}${crashes > 1 ? `, ${crashes} times while we watched` : ' while we watched'}, and did not get to a running tank. ` +
          'The screen stays black because it never gets as far as drawing. This is a bug on our side, and your report is how we find it.',
          [sendFirst, reinstall, erase]);
    } else if (crashes) {
      add('look', 'The tank crashed once while we watched',
          `It stopped with ${panics.length ? `"${panics[0][2]}"` : aborts.length ? 'an internal check' : 'a watchdog timeout'} and came back by itself. That should never happen.`,
          [sendFirst, 'If it keeps happening, reinstall from the <a href="/install/">install page</a>. It keeps your tank.']);
    }

    if (/Brownout detector was triggered/.test(text) || rsts.some(r => /BROWNOUT/.test(r[2]))) {
      add('problem', 'The power dipped and the board restarted',
          'The board saw its voltage drop too low. A weak cable, a hub, or a worn battery does this.',
          ['Plug straight into the computer or a wall charger, with another cable.', 'If it only happens on battery, the battery or its plug is the suspect.']);
    }
    if (/THE TANK TASK COULD NOT START|no framebuffer RAM/.test(text)) {
      add('problem', 'The tank ran out of memory while starting',
          'It started, but could not get the memory it needs to draw. This is a bug on our side.', [sendFirst, reinstall]);
    }
    if (!out.some(v => v.level === 'problem') && (/draw_bitmap y0=/.test(text) || (ver && running && ctx.sawBoot && !panel))) {
      add('problem', 'The screen is not taking the picture',
          'The tank is running, but the screen did not start or refuses what it is sent.',
          ['Force a restart: hold <kbd>PWR</kbd> for a full 10 seconds, let go, then hold it for one second.', sendFirst]);
    }
    if (/running WITHOUT saving/.test(text)) {
      add('problem', 'The tank cannot save',
          'Its storage did not open, so nothing you do now is kept. The saved tank was left as it is.', [sendFirst, reinstall]);
    } else if (/the tank save failed/.test(text)) {
      add('look', 'A save failed', 'The tank tried to save and could not. The last good save still stands.', [sendFirst]);
    }
    if (/no model partition|model mmap failed|advisor rules \(model missing\)/.test(text)) {
      add('look', 'The fish have no AI model',
          'The app is there, but the model that decides what the fish do is missing, so they follow simple rules.', [reinstall]);
    }

    const problems = out.filter(v => v.level === 'problem').length;
    if (asleep && !problems) {
      add('look', poweredOff ? 'The tank went to sleep and powered down' : 'The tank is asleep',
          poweredOff ? 'That is its normal deep sleep. A quick tap on the key does nothing from here.'
                     : 'It is in the first 20 minutes of sleep, where one press wakes it right where it was.',
          [poweredOff ? 'Hold <kbd>PWR</kbd> for one full second, then let go.' : 'Press <kbd>PWR</kbd>.']);
    } else if (running && !problems) {
      const dim = status && +status[10] === 0;
      const lowbat = status && +status[8] >= 0 && +status[8] <= 10;
      add('ok', 'The tank is running',
          `${status ? `${status[2]} fish, ` : fish.length ? 'Your fish are there, ' : ''}${fps ? `drawing ${fps[1]} frames a second` : 'answering on USB'}${ver ? `, version ${ver[1]}` : ''}. ` +
          'Your tank is alive and saved.',
          dim ? ['The screen brightness reads zero. Restart the tank: hold <kbd>PWR</kbd> for 10 seconds, let go, then hold it for one second.']
              : ['If the glass is black right now, the screen itself is not showing the picture. Force a restart: hold <kbd>PWR</kbd> for a full 10 seconds, let go, then hold it for one second.',
                 'Still black after that? Send us the report. It may be the screen or its connection inside the board.']);
      if (light && light[1] === 'night')
        add('look', 'The tank light is off', 'The picture is dim on purpose and the fish are resting.', ['Tap the glass twice, quickly, to turn the light on.']);
      if (lowbat) add('look', 'The battery is nearly empty', `It reads ${status[8]}%. Off the cable, the tank will shut down soon.`, ['Leave it plugged in for an hour.']);
    }
    if (pmic && parseInt(pmic[2], 16) & 0x08 && !asleep) {
      add('look', 'The last shutdown was the power running out',
          'The power chip says the tank last went dark because its power dropped too low, not because it chose to sleep. On battery that is an empty battery. On a cable it is the cable, the charger, or a loose plug.',
          ['Charge it for an hour on a cable and charger you trust.', 'If it runs fine on the cable but dies soon after unplugging, the battery is worn or not connected.']);
    }
    if (pmic && parseInt(pmic[2], 16) & 0x80) {
      add('look', 'The board got too hot', 'The power chip shut the board down for heat. Keep it out of the sun and off warm chargers.', []);
    }

    if (!out.length) {
      if (ctx.dropped && !text.trim()) {
        add('look', 'The board dropped off USB', 'It was there, then it left before saying anything. A board that is powering down or restarting over and over does this.',
            ['Hold <kbd>PWR</kbd> for one full second, wait five seconds, and click <em>Check my tank</em> again.', 'Try another cable, straight into the computer.']);
      } else if (!text.trim()) {
        add('look', 'The board is connected but silent',
            ctx.restarted ? 'Even after a restart it said nothing. It may be running something other than Pocket Tank, or the app is stuck before its first word.'
                          : 'It is powered and on USB, but it is not talking. It may be stuck.',
            ctx.restarted ? [reinstall, sendFirst] : ['Click <em>Restart and check again</em>. That restarts the board and reads its startup.']);
      } else if (ver || boots) {
        add('look', 'The tank started, but we did not see it running',
            'It began its startup and the check ended before the first sign of the tank drawing.',
            [ctx.restarted ? sendFirst : 'Click <em>Restart and check again</em> to watch a whole startup.']);
      } else {
        add('look', 'Nothing here we recognize', 'This does not look like a Pocket Tank log.', ['If it came from your tank, send it to us anyway.']);
      }
    }
    return { verdicts: out, facts, errors: [...new Set(text.split('\n').filter(l => /^E \(\d+\)/.test(l)).map(l => l.replace(/^E \(\d+\) /, '')))].slice(0, 12),
             backtrace: backtrace ? backtrace[1].trim() : '' };
  }

  /* the report: what the keeper posts. Wi-Fi names never leave the page. */
  const scrub = t => strip(t).replace(/(network saved: ).*?( \((?:with a password|open)\))/g, '$1(hidden)$2')
                             .replace(/(connected to )[^\n]*/g, '$1(hidden)').replace(/(ssid=)\S+/g, '$1(hidden)').replace(/(pass=)\S+/g, '$1(hidden)');
  const plain = h => h.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"');
  function report(d, log, how) {
    const L = [`Pocket Tank check, ${new Date().toISOString().slice(0, 16).replace('T', ' ')} UTC (pocketank.com/help)`, `How: ${how}`, ''];
    for (const v of d.verdicts) L.push(`[${v.level === 'ok' ? 'GOOD' : v.level === 'look' ? 'LOOK' : 'PROBLEM'}] ${v.title}: ${plain(v.body)}`);
    if (d.facts.length) { L.push(''); for (const [k, v] of d.facts) L.push(`${k}: ${v}`); }
    if (d.errors.length) { L.push('', 'Errors the tank logged:'); for (const e of d.errors) L.push(`  ${e}`); }
    const lines = scrub(log).split('\n');
    L.push('', `--- what the tank said (${lines.length} lines) ---`, ...lines);
    return L.join('\n');
  }

  window.TankCheck = { diagnose, report, scrub };

  /* ---------------- the page ---------------- */
  const root = document.querySelector('[data-check]');
  if (!root) return;
  const $ = s => root.querySelector(s);
  const statusEl = $('[data-check-status]'), resultEl = $('[data-check-result]'), logEl = $('[data-check-log]');
  const btnGo = $('[data-check-go]'), btnRestart = $('[data-check-restart]'), btnCopy = $('[data-check-copy]'), btnSave = $('[data-check-save]');
  const after = $('[data-check-after]');
  const MARK = { ok: ['GOOD', '✓'], look: ['LOOK HERE', '!'], problem: ['PROBLEM', '✕'] };
  let log = '', lastReport = '', port = null, reader = null, dropped = false, busy = false, sawBoot = false;

  const say = (s, working) => { statusEl.innerHTML = s ? `${working ? '<span class="spin" aria-hidden="true"></span>' : ''}<span>${s}</span>` : ''; };
  function show(d, how) {
    resultEl.innerHTML = d.verdicts.map(v =>
      `<div class="verdict ${v.level}"><span class="mark"><span aria-hidden="true">${MARK[v.level][1]}</span> ${MARK[v.level][0]}</span>` +
      `<h3>${esc(v.title)}</h3><p>${v.body}</p>${v.steps.length ? `<ol>${v.steps.map(s => `<li>${s}</li>`).join('')}</ol>` : ''}</div>`).join('') +
      (d.facts.length ? `<dl class="facts">${d.facts.map(([k, v]) => `<div><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>`).join('')}</dl>` : '');
    lastReport = report(d, log, how);
    after.hidden = false;
    resultEl.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  }
  const paint = () => { logEl.textContent = scrub(log) || '(nothing yet)'; logEl.scrollTop = logEl.scrollHeight; };
  const sleep = ms => new Promise(r => setTimeout(r, ms));

  async function pump() {                       /* everything the board says, as it says it */
    const dec = new TextDecoder();
    try {
      for (;;) {
        const { value, done } = await reader.read();
        if (done) break;
        log += dec.decode(value, { stream: true });
        if (/ESP-ROM:|pocket-tank v\S+ \S+ \(build/.test(log)) sawBoot = true;
        paint();
      }
    } catch (e) { dropped = true; }
  }
  async function send(line) {
    if (!port || !port.writable || dropped) return;
    const w = port.writable.getWriter();
    try { await w.write(new TextEncoder().encode(`\r\n${line}\r\n`)); } catch (e) { dropped = true; } finally { w.releaseLock(); }
  }
  async function ask() {                        /* the console's read-only answers */
    for (const c of ['state', 'battery', 'batlog', 'pmic']) { await send(c); await sleep(450); }
  }
  async function waitFor(re, ms) {
    const t0 = Date.now();
    while (Date.now() - t0 < ms && !dropped) { if (re.test(strip(log))) return true; await sleep(200); }
    return false;
  }
  async function close() {
    try { if (reader) await reader.cancel(); } catch (e) { }
    try { if (port) await port.close(); } catch (e) { }
    reader = null; port = null;
  }
  async function open() {
    port = await navigator.serial.requestPort({ filters: [{ usbVendorId: 0x303a }] });   /* Espressif: the board's own USB */
    await port.open({ baudRate: 115200, bufferSize: 65536 });
    dropped = false; reader = port.readable.getReader(); pump();
  }

  async function check(restart) {
    if (busy) return;
    busy = true; btnGo.disabled = btnRestart.disabled = true;
    try {
      if (!port || dropped) {
        await close(); log = ''; sawBoot = false; paint();
        try { await open(); } catch (e) {
          say(e && e.name === 'NotFoundError' ? 'No board picked. If the list was empty, see <a href="#no-usb">My tank is not in the list</a> below.'
                                              : `Could not open the board: ${esc(e && e.message || e)}. Close anything else using it (another tab, a serial monitor) and try again.`);
          port = null; return;
        }
      }
      if (restart) {
        say('Restarting the board and reading its startup. About 25 seconds.', true);
        log += '\n--- restart asked by the tank check ---\n';
        try {                                   /* EN low through the USB bridge, BOOT left alone: a plain restart */
          await port.setSignals({ dataTerminalReady: false, requestToSend: true });
          await sleep(120);
          await port.setSignals({ dataTerminalReady: false, requestToSend: false });
        } catch (e) { dropped = true; }
        const mark = log.length;
        const t0 = Date.now();
        while (Date.now() - t0 < 24000 && !dropped) {              /* the first fps line lands ~10 s after the tank task starts */
          if (/display: [\d.]+ fps/.test(strip(log.slice(mark)))) break;
          await sleep(250);
        }
        if (!dropped) { await ask(); await sleep(900); }
      } else {
        say('Listening to the tank. About 12 seconds.', true);
        await sleep(1500);
        await ask();                            /* a running tank answers at once */
        await waitFor(/display: [\d.]+ fps/, 10500);   /* its own report comes every 10 s */
        await sleep(300);
      }
      paint();
      const how = `USB${restart ? ', after a restart from the page' : ''}${dropped ? ', the board dropped off USB during the check' : ''}; ${navigator.userAgent.replace(/^Mozilla\/5\.0 /, '')}`;
      show(diagnose(log, { restarted: !!restart, dropped, sawBoot }), how);
      say(dropped ? 'The board left USB during the check.' : 'Done. The board is still connected.');
      btnRestart.hidden = false;
    } finally {
      busy = false; btnGo.disabled = btnRestart.disabled = false;
      btnGo.textContent = 'Check again';
    }
  }

  if (!('serial' in navigator)) {
    $('[data-check-unsupported]').hidden = false; btnGo.hidden = true;
  } else {
    btnGo.addEventListener('click', () => check(false));
    btnRestart.addEventListener('click', () => check(true));
    navigator.serial.addEventListener('disconnect', e => { if (e.target === port || e.port === port) dropped = true; });
  }
  btnCopy.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(lastReport); btnCopy.textContent = 'Copied'; }
    catch (e) { const r = $('[data-check-report]'); r.hidden = false; r.value = lastReport; r.select(); btnCopy.textContent = 'Select all, then copy'; }
    setTimeout(() => { btnCopy.textContent = 'Copy the report'; }, 2500);
  });
  btnSave.addEventListener('click', () => {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([lastReport], { type: 'text/plain' }));
    a.download = `pocket-tank-check-${new Date().toISOString().slice(0, 10)}.txt`;
    a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });
  $('[data-check-paste-go]').addEventListener('click', () => {
    log = $('[data-check-paste]').value; paint();
    show(diagnose(log, { restarted: true, sawBoot: /ESP-ROM:|pocket-tank v\S+ \S+ \(build/.test(log) }), 'a pasted log');
    say('Read the pasted log.');
  });
})();
